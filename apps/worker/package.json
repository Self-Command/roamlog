{
  "name": "@roamlog/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Roamlog BullMQ background worker",
  "exports": {
    ".": "./src/main.ts",
    "./queue": "./src/queue.ts"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1170.0",
    "@roamlog/db": "workspace:*",
    "@roamlog/emails": "workspace:*",
    "bullmq": "6.7.7",
    "ioredis": "5.11.1",
    "nodemailer": "10.6.0",
    "pino": "10.4.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/nodemailer": "8.0.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
