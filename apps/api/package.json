{
  "name": "@roamlog/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run test",
    "lint": "eslint .",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1170.0",
    "@aws-sdk/s3-request-presigner": "3.1170.0",
    "@nestjs/common": "12.5.1",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/platform-express": "12.5.1",
    "@roamlog/contracts": "workspace:*",
    "@roamlog/db": "workspace:*",
    "@sentry/node": "11.13.0",
    "@socket.io/redis-adapter": "8.3.0",
    "better-auth": "1.7.25",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "nodemailer": "10.6.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "sanitize-html": "2.18.2",
    "socket.io": "4.8.4",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.5.1",
    "@types/sanitize-html": "2.16.2",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/nodemailer": "8.0.2",
    "@types/node": "24.10.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
