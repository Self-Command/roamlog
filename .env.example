# ---------------------------------------------------------------------------
# Roamlog local development environment template
#
# Copy to .env.local and replace placeholders before deploying. This template is
# local-only. Production uses docker/production.env.example copied to
# /opt/roamlog/config/.env.production; the staging pair
# (docker/staging.env.example + docker/compose.staging.yml) is legacy staging,
# not production.
#
# Never commit .env, .env.local, .env.staging, tokens, or credentials.
# ---------------------------------------------------------------------------

NODE_ENV=development
# Deployment flavour validated by the API: development | staging | production |
# test. Production-only rules (public media endpoint, real mail transport) key
# off APP_ENV, not NODE_ENV, because staging also runs NODE_ENV=production.
APP_ENV=development
LOG_LEVEL=debug
NEXT_TELEMETRY_DISABLED=1
# Optional explicit dotenv path for non-default working directories.
ROAMLOG_ENV_FILE=

# Local application URLs and ports
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000
BETTER_AUTH_URL=http://localhost:4000
WEB_PORT=3000
ADMIN_PORT=3001
API_PORT=4000
# [optional] Grace budget for SIGTERM/SIGINT: stop accepting requests, wait for
# in-flight work, close DB/Redis/queue, then exit 0. On expiry the API force-exits
# with code 1. Milliseconds, 0-300000. Default: 10000.
SHUTDOWN_GRACE_MS=10000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
TRUST_PROXY=false
ADMIN_2FA_ENFORCED=false
SESSION_COOKIE_DOMAIN=
# Data source is fixed to the live API: there is no mock mode and no
# data-source switch to set here.
# Deployment identity inlined into the web/admin bundles at build time; it
# drives the Admin environment badge. Without it the badge falls back to
# NODE_ENV, so a staging image built with NODE_ENV=production would claim
# "PRODUCTION". Docker builds pass it as a build arg (default: production).
NEXT_PUBLIC_APP_ENV=development
# Optional same-domain Admin deployment values. Leave unset for local :3001.
# NEXT_PUBLIC_ADMIN_ASSET_PREFIX=/admin-assets
# NEXT_PUBLIC_ADMIN_LOGIN_PATH=/admin/login
# Admin BFF proxy target (apps/admin/app/v1/[...path]/route.ts). Leave unset
# locally; production sets it to the API origin reachable from the Admin server.
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
# [optional] Admin demo banner toggle (build-time). true only for demo builds.
NEXT_PUBLIC_ADMIN_DEMO=false
NEXT_PUBLIC_API_URL=http://localhost:4000
ROAMLOG_API_ORIGIN=http://localhost:4000

# PostgreSQL 17
POSTGRES_USER=roamlog
POSTGRES_PASSWORD=roamlog
POSTGRES_DB=roamlog
POSTGRES_PORT=5432
DATABASE_URL=postgresql://roamlog:roamlog@localhost:5432/roamlog?schema=public

# Redis 7 / BullMQ
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=roamlog
# [optional] true = Redis is part of the baseline: the API refuses to boot when
# Redis is unreachable. false (default) = fail-open: cache/rate-limit/quota calls
# degrade and the API still serves. Runtime outages never kill a running API.
REDIS_REQUIRED=false

# API rate limits (requests per window; defaults mirror the schema in
# apps/api/src/config/environment.ts)
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=10
PUBLIC_SHARE_RATE_LIMIT_MAX=60
PUBLIC_SHARE_PASSWORD_RATE_LIMIT_MAX=20
MEDIA_PRESIGN_RATE_LIMIT_MAX=20

# Authentication (Better Auth)
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# S3-compatible storage (MinIO locally)
#
# Official MinIO community images are no longer anonymously pullable from
# Docker Hub/Quay. Use a verified mirror or authenticated Quay access and pin
# the exact image/digest before starting a fresh environment.
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-10-15T17-29-55Z
MINIO_MC_IMAGE=quay.io/minio/mc:RELEASE.2025-08-13T08-35-41Z
MINIO_ROOT_USER=roamlog
MINIO_ROOT_PASSWORD=roamlog-local-secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=roamlog-local
S3_ACCESS_KEY=roamlog
S3_SECRET_KEY=roamlog-local-secret
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# Browser-facing origin used ONLY to presign media URLs (GET reads, PUT
# uploads). SigV4 signs the Host header, so production must use the public TLS
# media origin; locally it may equal S3_ENDPOINT. Must be https and a public
# host (no minio/localhost/private IP) when APP_ENV=production.
S3_PUBLIC_ENDPOINT=http://localhost:9000
# Reserved unsigned CDN/origin base URL for public objects. Optional and
# currently unused: workspace media stays private and is served through
# presigned URLs. When set it is validated with the same rules as
# S3_PUBLIC_ENDPOINT.
S3_PUBLIC_BASE_URL=http://localhost:9000/roamlog-local
# Lifetime of media read/upload URLs in seconds (60-604800). Deliberately
# separate from EXPORT_SIGNED_URL_TTL so images and downloads can be tuned
# apart.
MEDIA_SIGNED_URL_TTL_SECONDS=900
# Comma-separated browser origins allowed by the bucket CORS policy applied by
# docker/minio-init. Media is served from the S3/media host, so reads and
# uploads are cross-origin from the web app. Must list at least one origin and
# include APP_URL; production requires https bare origins.
MEDIA_CORS_ORIGINS=http://localhost:3000

# Email (Mailpit locally; SMTP or Resend in staging)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# Mail transport: mailpit (local catcher) | smtp (relay reachable from the
# container) | resend (HTTP API). When APP_ENV=production, mailpit is rejected,
# resend requires a real re_... key with SMTP_HOST empty, and smtp rejects the
# local catcher host and port 1025.
EMAIL_PROVIDER=mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=re_local_placeholder
EMAIL_FROM=Roamlog <hello@roamlog.local>

# Observability
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
OTEL_EXPORTER_OTLP_ENDPOINT=

# Maps / geocoding
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
NEXT_PUBLIC_GEOCODER_URL=https://nominatim.openstreetmap.org

# Place search (see docs/operations/places.md)
# [optional] Primary source: geoapify | photon. Default: geoapify.
PLACES_PROVIDER=geoapify
# [optional] Geoapify API key, server-side only. Empty = Geoapify is skipped and
# Photon serves when fallback is enabled. The Admin UI can override it as the
# encrypted setting places.apiKey.
GEOAPIFY_API_KEY=
# [optional] Fall back to Photon when Geoapify is missing, failing or over quota.
# Default: true.
PLACES_FALLBACK_TO_PHOTON=true
# [optional] Redis cap for Geoapify requests per UTC day; 0 disables the cap.
# Default: 3000 (Geoapify free plan).
GEOAPIFY_DAILY_LIMIT=3000

# [optional] Advanced Places knobs. Defaults are correct for production; change
# only during an incident or a capacity change. Admin settings places.* win over
# these once saved (no places key is env-locked).
# Geoapify autocomplete endpoint and 1.2 s primary budget (ms, 1-30000).
GEOAPIFY_URL=https://api.geoapify.com/v1/geocode/autocomplete
GEOAPIFY_TIMEOUT_MS=1200
# Photon fallback endpoint and budget (ms, 1-30000).
PHOTON_URL=https://photon.komoot.io/api
PHOTON_TIMEOUT_MS=2500
# Defaults when a request omits lang/limit (zh|en, 1-10).
PLACES_LANG=zh
PLACES_LIMIT=6
# Cached results TTL (1-86400 s) and empty/degraded TTL (1-3600 s).
PLACES_CACHE_TTL_SECONDS=900
PLACES_EMPTY_CACHE_TTL_SECONDS=30
# Per user+IP rate limit: requests, window seconds, Redis timeout.
PLACES_RATE_LIMIT_MAX=30
PLACES_RATE_LIMIT_WINDOW_SECONDS=60
PLACES_RATE_LIMIT_TIMEOUT_MS=750
PLACES_REDIS_TIMEOUT_MS=500

# Settings encryption (see docs/operations/settings-encryption.md)
# [required in production] AES-256-GCM key for secrets saved in Admin settings
# (SMTP password, S3 secret, places key). It must be exactly 32 bytes, base64.
# Generate one with: openssl rand -base64 32
# Local may leave this empty; saving a secret then fails with
# SETTINGS_ENCRYPTION_UNAVAILABLE. LOSING THE KEY MAKES SAVED SECRETS
# PERMANENTLY UNDECRYPTABLE - there is no recovery.
CONFIG_ENCRYPTION_KEY=
# [optional] Comma-separated key ring for rotation; the first entry is the
# current encryption key. Leave empty outside a rotation.
CONFIG_ENCRYPTION_KEYS=

# AI planner (see docs/operations/ai-provider.md)
# [runtime] There is no on/off switch: the API treats AI as configured when
# AI_BASE_URL + AI_MODEL are both set. To turn AI off, empty all three endpoint
# values (AI_BASE_URL/AI_API_KEY/AI_MODEL); the endpoints then answer
# 503 AI_NOT_CONFIGURED. `pnpm check:env` fails when AI_BASE_URL is set without
# AI_MODEL, so the preflight and the runtime cannot disagree.
# [optional] openai-chat | openai-responses | anthropic-messages.
# Default: openai-chat.
AI_PROTOCOL=openai-chat
# [optional] Full API root, for example
# https://api.openai.com/v1 or http://127.0.0.1:3425/v1 for a local gateway.
AI_BASE_URL=
# [optional] Provider key or gateway token. Server-side only.
AI_API_KEY=
# [optional] Model id, for example gpt-4o-mini.
AI_MODEL=
# [optional] Hard upstream budget in milliseconds, 5000-120000. Default: 60000.
AI_TIMEOUT_MS=60000
# [optional] Max output tokens per call, 256-32000. Default: 6000.
AI_MAX_OUTPUT_TOKENS=6000
# [optional] Per-user daily plan runs; 0 disables the cap. Default: 20.
AI_DAILY_QUOTA=20
# [optional] Image input capability for chat attachments. The gateway's
# /v1/models `modalities` field is NOT trustworthy (models that advertise image
# support skip visual analysis and return empty content), so the capability must
# be declared explicitly. Default: false. Accepted: true/1/yes/on, false/0/no/off;
# any other value (e.g. a typo) fails the API start and `pnpm check:env`.
# Set it to true only after verifying the model really accepts images.
AI_VISION_SUPPORTED=false

# Upload compression reference values (see docs/operations/media-pipeline.md)
# These are NOT read by the web or API: the browser compressor reads the public
# Admin settings media.maxEdge/media.quality/media.targetBytes/media.maxUploadBytes.
# They exist for `pnpm check:env` range validation and as documentation only.
# [optional] Longest edge in px after resize, 320-8192. Default: 2000.
MEDIA_MAX_EDGE=2000
# [optional] Encoder quality, 1-100. Default: 82 (0.82 in the encoder ladder).
MEDIA_QUALITY=82
# [optional] Target compressed size in bytes. Default: 1500000.
MEDIA_TARGET_BYTES=1500000
# [optional] Preflight-only reference; the Admin switch media.keepOriginal is
# also unwired. Default: false.
MEDIA_KEEP_ORIGINAL=false

# Exports and one-time admin bootstrap
EXPORT_SIGNED_URL_TTL=900
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@roamlog.local
BOOTSTRAP_SUPER_ADMIN_NAME=Roamlog Platform Administrator

# ---------------------------------------------------------------------------
# Build metadata and internal harness values (never needed for a normal
# deployment; listed here so every key the repo reads is documented)
# ---------------------------------------------------------------------------
# [build] Injected by the release build; empty locally.
ROAMLOG_BUILD_TIME=
ROAMLOG_API_VERSION=
ROAMLOG_WORKER_VERSION=
# [build] Mailpit API base used by local harnesses; the worker derives it from
# MAILPIT_UI_PORT when unset.
MAILPIT_URL=http://localhost:8025
# [test] Only read by the test/e2e harnesses; never set these in production.
ROAMLOG_TEST_DATABASE_URL=
ROAMLOG_TEST_REDIS_URL=
ROAMLOG_STAGING_SERVICES=
ROAMLOG_STAGING_BOOTSTRAP_DATABASE_URL=
ROAMLOG_STAGING_MAILPIT_URL=
ROAMLOG_STAGING_SMTP_HOST=
ROAMLOG_STAGING_SMTP_PORT=
ROAMLOG_STAGING_S3_ENDPOINT=
ROAMLOG_STAGING_S3_BUCKET=
ROAMLOG_STAGING_S3_REGION=
ROAMLOG_STAGING_S3_ACCESS_KEY=
ROAMLOG_STAGING_S3_SECRET_KEY=
SMOKE_EMAIL_TO=

# Seed controls (local/staging only; never enable in production)
DEMO_SEED_ENABLED=true
DEMO_OWNER_EMAIL=demo@roamlog.local
DEMO_EDITOR_EMAIL=mei@roamlog.local
DEMO_VIEWER_EMAIL=jonas@roamlog.local
ROAMLOG_SEED_S3_UPLOAD=false
ROAMLOG_SEED_PRINT_SHARE_TOKEN=false
