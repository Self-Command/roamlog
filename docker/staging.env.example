# Roamlog staging environment template.
# Copy to docker/.env.staging, replace every placeholder, and never commit it.
# Run compose with: docker compose --env-file docker/.env.staging -f docker/compose.staging.yml ...

NODE_ENV=production
# [fixed] Staging declares itself: production-only mail/media rules stay off,
# so the Mailpit catcher below remains allowed.
APP_ENV=staging
# [fixed] Container-internal API port used by docker/compose.staging.yml.
API_PORT=4000
LOG_LEVEL=info
NEXT_TELEMETRY_DISABLED=1
ROAMLOG_ENV_FILE=

# Public HTTPS origins. Keep web, admin, and API on the same staging parent
# domain so Secure SameSite=Lax session cookies can be shared safely.
APP_URL=https://app.staging.roamlog.app
ADMIN_URL=https://admin.staging.roamlog.app
API_URL=https://api.staging.roamlog.app
CORS_ORIGINS=https://app.staging.roamlog.app,https://admin.staging.roamlog.app
SESSION_COOKIE_DOMAIN=.staging.roamlog.app
TRUST_PROXY=true
ADMIN_2FA_ENFORCED=true
BETTER_AUTH_URL=https://api.staging.roamlog.app

# Internal compose endpoints override these values for container-to-container
# traffic. Keep schemas and credentials aligned with the POSTGRES_* block.
DATABASE_URL=postgresql://roamlog:replace-with-a-long-database-password@postgres:5432/roamlog?schema=public
POSTGRES_USER=roamlog
POSTGRES_PASSWORD=replace-with-a-long-database-password
POSTGRES_DB=roamlog

REDIS_PASSWORD=replace-with-a-long-redis-password
REDIS_URL=redis://:replace-with-a-long-redis-password@redis:6379/0
REDIS_PREFIX=roamlog-staging

# API rate limits (defaults mirror apps/api/src/config/environment.ts)
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=10
PUBLIC_SHARE_RATE_LIMIT_MAX=60
PUBLIC_SHARE_PASSWORD_RATE_LIMIT_MAX=20
MEDIA_PRESIGN_RATE_LIMIT_MAX=20

# Generate at least 48 random bytes. Replacing this invalidates active sessions.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes-before-starting-staging

# Settings encryption. 32-byte base64 AES-256-GCM key for secrets saved in
# Admin settings. Generate: openssl rand -base64 32
# Staging must use a real key before a secret can be saved; losing it makes
# stored secrets permanently undecryptable. See docs/operations/settings-encryption.md.
CONFIG_ENCRYPTION_KEY=CHANGE_ME_base64_32_bytes
# [optional] Rotation key ring, comma separated, first entry = current key.
CONFIG_ENCRYPTION_KEYS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# MinIO bootstrap credentials. S3_ACCESS_KEY must be a dedicated application
# identity, not MINIO_ROOT_USER, when running in staging.
#
# MinIO stopped anonymous publishing of community images. Authenticate to
# Quay and pull these pinned tags, or mirror the verified digest into the
# organisation registry and override both image variables.
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-10-15T17-29-55Z
MINIO_MC_IMAGE=quay.io/minio/mc:RELEASE.2025-08-13T08-35-41Z
MINIO_ROOT_USER=roamlog-staging-root
MINIO_ROOT_PASSWORD=replace-with-a-long-minio-root-password
MINIO_BROWSER_REDIRECT_URL=
S3_ENDPOINT=http://minio:9000
# [fixed] Staging signs media URLs against the internal MinIO endpoint; there is
# no public media host in the legacy staging stack.
S3_PUBLIC_ENDPOINT=http://minio:9000
# [optional] Lifetime of media read/upload URLs in seconds, 60-604800.
# Default: 900.
MEDIA_SIGNED_URL_TTL_SECONDS=900
S3_BUCKET=roamlog-staging
S3_ACCESS_KEY=roamlog-staging-app
S3_SECRET_KEY=replace-with-a-long-s3-application-secret
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=

# Compose staging uses Mailpit. Replace with a verified Resend domain/provider
# only after confirming delivery, bounce, and complaint handling.
# [fixed] Explicit so the schema default (smtp) cannot silently change routing.
EMAIL_PROVIDER=mailpit
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=
EMAIL_FROM=Roamlog Staging <staging@roamlog.app>

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
OTEL_EXPORTER_OTLP_ENDPOINT=

NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
NEXT_PUBLIC_GEOCODER_URL=https://nominatim.openstreetmap.org

# Place search (see docs/operations/places.md)
# [optional] geoapify | photon. Default: geoapify.
PLACES_PROVIDER=geoapify
# [optional] Geoapify key, server-side only. Empty = Photon fallback serves.
GEOAPIFY_API_KEY=
# [optional] Fall back to Photon on failure/quota. Default: true.
PLACES_FALLBACK_TO_PHOTON=true
# [optional] Redis daily Geoapify cap; 0 disables. Default: 3000.
GEOAPIFY_DAILY_LIMIT=3000

# AI planner (see docs/operations/ai-provider.md)
# [optional] true requires AI_BASE_URL/AI_API_KEY/AI_MODEL; false keeps the
# endpoints at 503 AI_NOT_CONFIGURED. Default: false.
AI_ENABLED=false
# [optional] openai-chat | openai-responses | anthropic-messages. Default: openai-chat.
AI_PROTOCOL=openai-chat
# [optional when AI is disabled] Full API root.
AI_BASE_URL=
# [optional when AI is disabled] Provider key or gateway token. Server-side only.
AI_API_KEY=
# [optional when AI is disabled] Model id.
AI_MODEL=
# [optional] Upstream budget in ms, 5000-120000. Default: 60000.
AI_TIMEOUT_MS=60000
# [optional] Max output tokens per call, 256-32000. Default: 6000.
AI_MAX_OUTPUT_TOKENS=6000
# [optional] Per-user daily plan runs; 0 disables. Default: 20.
AI_DAILY_QUOTA=20

# Upload compression (web client; see apps/web/lib/image)
# [optional] Longest edge in px, 320-8192. Default: 2000.
MEDIA_MAX_EDGE=2000
# [optional] Encoder quality, 1-100. Default: 82.
MEDIA_QUALITY=82
# [optional] Target compressed size in bytes. Default: 1500000.
MEDIA_TARGET_BYTES=1500000
# [optional] Keep the original file instead of the compressed one. Default: false.
MEDIA_KEEP_ORIGINAL=false
# Data source is fixed to the live API: there is no mock mode, and the retired
# data-mode build args are no longer read.
# Admin image build args (also set explicitly in compose.staging.yml):
# NEXT_PUBLIC_ADMIN_ASSET_PREFIX=/admin-assets
# NEXT_PUBLIC_ADMIN_LOGIN_PATH=/admin/login

EXPORT_SIGNED_URL_TTL=900

BOOTSTRAP_SUPER_ADMIN_EMAIL=platform-admin@roamlog.app
BOOTSTRAP_SUPER_ADMIN_NAME=Roamlog Platform Administrator

# Staging compose must not seed demo fixtures automatically. The current seed
# command refuses NODE_ENV=production; demo data needs an explicit product and
# data-handling decision.
DEMO_SEED_ENABLED=false
ROAMLOG_SEED_S3_UPLOAD=false
ROAMLOG_SEED_PRINT_SHARE_TOKEN=false

# Loopback-only host ports. Put a TLS reverse proxy in front of the API, web,
# and admin ports; never expose Postgres, Redis, or Mailpit directly.
ROAMLOG_IMAGE_TAG=local
STAGING_WEB_PORT=13000
STAGING_ADMIN_PORT=13001
STAGING_API_PORT=14000
STAGING_MAILPIT_UI_PORT=18025
STAGING_MINIO_CONSOLE_PORT=19001
