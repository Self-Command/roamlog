# Roamlog production environment template.
#
# Copy to /opt/roamlog/config/.env.production (mode 0600, owner root) and
# replace every CHANGE_ME / example placeholder before starting the stack:
#
#   install -d -m 700 /opt/roamlog/config
#   install -m 600 docker/production.env.example /opt/roamlog/config/.env.production
#
# Nothing in this file is a real credential. This file is a template only and
# must never be committed with populated values.
#
# Marking convention
#   [deployer]  filled in by the person deploying the release
#   [secret]    injected from the approved secret store / password manager
#               (never typed into a ticket, chat, or Git)
#   [fixed]     already correct for the production stack; do not change casually
#
# The API validates this file at boot. With APP_ENV=production it refuses to
# start when the mail transport is underspecified, when EMAIL_PROVIDER=mailpit,
# when EMAIL_FROM still points at a .local domain, or when S3_PUBLIC_ENDPOINT is
# missing / not a public https origin. Keep APP_ENV=production.

# ---------------------------------------------------------------------------
# Runtime flavour
# ---------------------------------------------------------------------------
# [fixed] APP_ENV drives the strict production checks (mail transport, provider).
# It is independent from NODE_ENV, which only selects Node runtime behaviour.
APP_ENV=production
NODE_ENV=production
LOG_LEVEL=info
NEXT_TELEMETRY_DISABLED=1

# ---------------------------------------------------------------------------
# API port and rate limits
# ---------------------------------------------------------------------------
# [fixed] Container-internal API port. Nginx proxies the loopback host port
# PRODUCTION_API_PORT to this value; do not expose 4000 on the host.
API_PORT=4000
# [fixed] Requests per window. Defaults mirror the API schema; change only with
# a capacity note, because tightening them can lock out shared-NAT offices.
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=10
PUBLIC_SHARE_RATE_LIMIT_MAX=60
PUBLIC_SHARE_PASSWORD_RATE_LIMIT_MAX=20
MEDIA_PRESIGN_RATE_LIMIT_MAX=20

# ---------------------------------------------------------------------------
# Public origins (host Nginx terminates TLS)
# ---------------------------------------------------------------------------
# [deployer] Must match the certificate and the Nginx server block.
APP_URL=https://CHANGE_ME.example.com
ADMIN_URL=https://CHANGE_ME.example.com/admin
API_URL=https://CHANGE_ME.example.com
BETTER_AUTH_URL=https://CHANGE_ME.example.com
CORS_ORIGINS=https://CHANGE_ME.example.com
SESSION_COOKIE_DOMAIN=.CHANGE_ME.example.com
TRUST_PROXY=true
ADMIN_2FA_ENFORCED=true

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# [secret] Long random password; also referenced by the compose interpolation.
POSTGRES_USER=roamlog
POSTGRES_PASSWORD=CHANGE_ME_database_password
POSTGRES_DB=roamlog
DATABASE_URL=postgresql://roamlog:CHANGE_ME_database_password@postgres:5432/roamlog?schema=public

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
# [secret]
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_URL=redis://:CHANGE_ME_redis_password@redis:6379/0
REDIS_PREFIX=roamlog

# ---------------------------------------------------------------------------
# Sessions and auth
# ---------------------------------------------------------------------------
# [secret] Generate at least 48 random bytes. Rotating it invalidates all
# sessions and pending verification links.
BETTER_AUTH_SECRET=CHANGE_ME_at_least_32_random_bytes
# [deployer] Leave empty to disable the provider rather than shipping a dummy id.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Object storage (MinIO, private)
# ---------------------------------------------------------------------------
# [secret] MINIO_ROOT_* bootstraps the service. S3_ACCESS_KEY must be a
# dedicated application identity, never MINIO_ROOT_USER.
MINIO_ROOT_USER=roamlog-prod-root
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_root_password
S3_ENDPOINT=http://minio:9000
S3_BUCKET=roamlog-production
S3_ACCESS_KEY=roamlog-prod-app
S3_SECRET_KEY=CHANGE_ME_s3_application_secret
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# [fixed] Optional override for the MinIO client image used by the one-shot
# bucket bootstrap. Pin a reviewed tag or digest here; the compose default is
# the release tag below.
MINIO_MC_IMAGE=quay.io/minio/mc:RELEASE.2025-08-13T08-35-41Z
# [fixed] Public media origin used ONLY to sign browser-facing URLs. SigV4
# signs the Host header, so this must be the TLS host served by
# deploy/nginx/media.conf.example (Nginx forwards the original Host to MinIO).
# Never minio:9000, localhost or a private IP: with APP_ENV=production the API
# refuses to boot without a public https origin, and the stack fails fast at
# `docker compose config` time because this variable is required.
# See docs/operations/media-delivery.md.
S3_PUBLIC_ENDPOINT=https://media.CHANGE_ME.example.com
# [fixed] Optional unsigned public object base URL (CDN). Reserved: workspace
# media stays private and is served through presigned URLs only.
S3_PUBLIC_BASE_URL=
# [fixed] Lifetime of media read/upload URLs in seconds, 60-604800 (default 900).
MEDIA_SIGNED_URL_TTL_SECONDS=900
# [deployer] Comma-separated browser origins allowed by the bucket CORS policy.
# Must include the APP_URL origin (the web app), because uploads/reads are
# cross-origin: media is served from the media host, not the app host.
# `pnpm check:env -- --env production` rejects a list without the APP_URL origin.
MEDIA_CORS_ORIGINS=https://CHANGE_ME.example.com
MINIO_BROWSER_REDIRECT_URL=

# ---------------------------------------------------------------------------
# Email delivery (the reason this template exists)
# ---------------------------------------------------------------------------
# [deployer] EMAIL_PROVIDER=resend  -> Resend HTTP API, needs RESEND_API_KEY.
#            EMAIL_PROVIDER=smtp    -> relay reachable from the API container,
#                                      needs SMTP_HOST/PORT/USER/PASSWORD.
#            EMAIL_PROVIDER=mailpit -> REJECTED when APP_ENV=production.
# The worker sends provider HTTP mail only; see docs/operations/email-production.md
# before choosing smtp for worker-originated mail.
EMAIL_PROVIDER=resend

# [deployer] Must be an address on a domain verified with the provider. It may
# not end in .local (production rejects it). Format: Name <local@domain>.
EMAIL_FROM=Roamlog <no-reply@CHANGE_ME.example.com>

# Resend path -----------------------------------------------------------------
# [secret] Resend API key (starts with re_). Prefer a sending-only key scoped to
# the production domain. Leave SMTP_* empty when EMAIL_PROVIDER=resend: a stale
# SMTP_HOST makes the API prefer SMTP over Resend.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# SMTP relay path -------------------------------------------------------------
# [secret] Only when EMAIL_PROVIDER=smtp. Use the provider relay hostname, not
# a local catcher: mailpit / localhost / 127.0.0.1 are rejected in production,
# and the local catcher port 1025 is rejected as well. Typical port: 587.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=CHANGE_ME_smtp_user
# SMTP_PASSWORD=CHANGE_ME_smtp_password

# ---------------------------------------------------------------------------
# Release, observability, exports
# ---------------------------------------------------------------------------
# [deployer] Release tag to deploy, e.g. v0.1.0. Every GHCR image uses it.
ROAMLOG_IMAGE_TAG=CHANGE_ME_release_tag
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
EXPORT_SIGNED_URL_TTL=900
BOOTSTRAP_SUPER_ADMIN_EMAIL=CHANGE_ME_platform_admin@CHANGE_ME.example.com

# ---------------------------------------------------------------------------
# Loopback-only host ports (Nginx proxies API/Web/Admin on 127.0.0.1)
# ---------------------------------------------------------------------------
PRODUCTION_WEB_PORT=13000
PRODUCTION_ADMIN_PORT=13001
PRODUCTION_API_PORT=14000
PRODUCTION_MINIO_S3_PORT=19000
PRODUCTION_MINIO_CONSOLE_PORT=19001
