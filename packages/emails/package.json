{
  "name": "@roamlog/emails",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Roamlog transactional email templates",
  "exports": {
    ".": "./src/index.ts",
    "./templates": "./src/templates/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "email:smoke": "tsx src/smoke.ts"
  },
  "dependencies": {
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.0.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
