{
  "name": "@roamlog/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./factories": "./src/factories.ts",
    "./seed": "./seed.ts"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "prisma": "prisma",
    "db:seed": "tsx seed.ts",
    "db:reset": "prisma migrate reset --force",
    "test": "prisma validate && vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1170.0",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "prisma": "7.10.1",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
