{
  "name": "@roamlog/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./generated/*": "./src/generated/*"
  },
  "scripts": {
    "api-client:generate": "orval --config orval.config.ts",
