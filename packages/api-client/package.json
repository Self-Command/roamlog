    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "orval": "8.48.0",
    "react": "19.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
