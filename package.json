{
  "name": "roamlog",
  "version": "0.0.0",
  "private": true,
  "description": "Roamlog collaborative travel archive",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @roamlog/db prisma migrate deploy",
    "db:seed": "pnpm --filter @roamlog/db db:seed",
    "db:studio": "pnpm --filter @roamlog/db prisma studio",
    "contracts:generate": "pnpm --filter @roamlog/contracts contracts:generate",
    "contracts:check": "pnpm --filter @roamlog/contracts contracts:check && pnpm --filter @roamlog/api-client api-client:check",
    "api-client:generate": "pnpm --filter @roamlog/api-client api-client:generate",
    "admin:bootstrap": "pnpm --filter @roamlog/api exec tsx scripts/bootstrap-admin.ts",
    "tooling:minio-smoke": "tsx tooling/scripts/minio-smoke.ts",
    "check:env": "tsx tooling/scripts/check-env.ts",
    "staging:validate": "python tooling/scripts/staging-validate.py",
    "staging:config": "docker compose --env-file docker/.env.staging -f docker/compose.staging.yml config",
    "e2e": "playwright test",
    "e2e:live": "playwright test --config=playwright.live.config.ts",
    "e2e:staging": "playwright test --config=playwright.staging.config.ts",
    "e2e:live:fixture": "pnpm --filter @roamlog/api exec tsx ../../tooling/scripts/e2e-auth-fixture.ts",
    "e2e:live:cleanup": "pnpm --filter @roamlog/api exec tsx ../../tooling/scripts/e2e-auth-fixture.ts --cleanup",
    "e2e:web": "playwright test --project=web",
    "e2e:admin": "playwright test --project=admin",
    "e2e:api": "playwright test --project=api",
    "e2e:report": "playwright show-report",
    "e2e:a11y": "playwright test --config=playwright.a11y.config.ts",
    "e2e:a11y:axe": "playwright test --config=playwright.a11y.config.ts --grep @axe",
    "e2e:a11y:keyboard": "playwright test --config=playwright.a11y.config.ts --grep @keyboard",
    "e2e:visual": "playwright test --config=playwright.a11y.config.ts --project=web-visual --project=admin-visual",
    "security:check": "pnpm audit --audit-level high",
    "k6:smoke": "k6 run tooling/scripts/k6-smoke.js",
    "k6:smoke:check": "node --input-type=module --check < tooling/scripts/k6-smoke.js",
    "k6:staging:smoke": "k6 run --summary-export tooling/k6/artifacts/staging-smoke-summary.json tooling/k6/staging-smoke.js",
    "k6:staging:security": "k6 run --summary-export tooling/k6/artifacts/staging-security-summary.json tooling/k6/staging-security.js",
    "k6:staging:check": "node --input-type=module --check < tooling/k6/staging-smoke.js && node --input-type=module --check < tooling/k6/staging-security.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "24.10.1",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "turbo": "2.11.11",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  }
}
