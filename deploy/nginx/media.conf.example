# Roamlog production media ingress for https://media.spacedo.org.
#
# WHY THIS FILE EXISTS
# Presigned S3 URLs sign the `Host` header (SigV4). The API therefore signs
# media URLs against the public origin (S3_PUBLIC_ENDPOINT) while it keeps using
# the internal `http://minio:9000` endpoint for its own S3 calls. This server
# block is what makes the signed URL valid outside the Docker network:
#
#   browser --https--> nginx (Host: media.spacedo.org) --http--> 127.0.0.1:19000
#                                 |                                    |
#                          keeps Host header                    MinIO verifies
#                                                               SigV4 over that
#                                                               same Host
#
# DO NOT rewrite the path or the hostname. Any `proxy_set_header Host minio:9000`
# or `/media/` prefix-rewrite makes every presigned request fail with
# 403 SignatureDoesNotMatch. See docs/operations/media-delivery.md.
#
# ---------------------------------------------------------------------------
# REPLACE THE MEDIA HOSTNAME
#
# `media.spacedo.org` below is a placeholder. Replace it in all four places:
#   1. `server_name` (both server blocks)
#   2. the certbot certificate/key paths
#   3. the HTTP->HTTPS log file names (cosmetic)
#   4. S3_PUBLIC_ENDPOINT in /opt/roamlog/config/.env.production
# and in S3_PUBLIC_ENDPOINT. The Nginx `Host` header is authoritative: the API
# signs exactly the host it is configured with.
#
# ---------------------------------------------------------------------------
# CLOUDFLARE NOTES (only if the hostname is proxied / orange-cloud)
#
# - Host: Cloudflare keeps the browser's Host (`media.spacedo.org`) when it
#   connects to the origin, so the signature stays valid. Do not enable any
#   rule that rewrites the origin Host.
# - Real IP: install the published Cloudflare ranges in
#   /etc/nginx/snippets/cloudflare-realip.conf and keep
#   `real_ip_header CF-Connecting-IP` (see cloudflare-realip.conf.example).
#   Restrict origin TCP 80/443 to those ranges so the public cannot bypass it.
# - TLS: origin certificate mode must be Full (strict) with a valid cert.
# - Caching: bypass cache for any request whose query string contains
#   `X-Amz-Signature` / `X-Amz-Credential`. A cached response would outlive the
#   signed URL lifetime and leak a private object after expiry.
# - Query strings: Cloudflare forwards them untouched; do not enable
#   normalisation that drops or sorts parameters.
# - Hotlink protection / image resizing features must stay off: both rewrite or
#   re-fetch signed URLs and break the signature.

server {
    listen 80;
    listen [::]:80;
    server_name media.spacedo.org;

    include /etc/nginx/snippets/cloudflare-realip.conf;
    access_log /var/log/nginx/roamlog-media-http.access.log;
    error_log /var/log/nginx/roamlog-media-http.error.log;

    # Certbot HTTP-01 challenge must stay reachable on plain HTTP.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name media.spacedo.org;
    server_tokens off;

    include /etc/nginx/snippets/cloudflare-realip.conf;
    include /etc/letsencrypt/options-ssl-nginx.conf;

    ssl_certificate /etc/letsencrypt/live/media.spacedo.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/media.spacedo.org/privkey.pem;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Media is private per object, so it must not be indexed or framed.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Cross-Origin-Resource-Policy "cross-origin" always;
    # Defense in depth: even if a non-image slips through, it cannot execute.
    add_header Content-Security-Policy "default-src 'none'; sandbox" always;
    # Signed URLs are bearer credentials: never let an intermediary cache them.
    # A cached object would outlive its signature and stay readable after expiry.
    add_header Cache-Control "private, no-store" always;

    # Never force a download: media URLs are embedded (<img>) and opened inline.
    # Hiding an upstream Content-Disposition keeps the browser's inline
    # behaviour authoritative for the stored content type.
    proxy_hide_header Content-Disposition;
    # MinIO would otherwise advertise itself in every response. `server_tokens
    # off` above hides the nginx version; removing the nginx Server header
    # entirely needs the headers-more module (optional hardening).
    proxy_hide_header Server;

    # Directory listings are not a thing for the S3 API, and this host must not
    # grow one: no autoindex, and no console/health surface.
    autoindex off;
    location ^~ /minio/ {
        return 404;
    }

    # A presigned PUT body can be up to the API's 25 MB object cap; keep a small
    # margin for multipart framing. Reads are streamed, not buffered.
    client_max_body_size 30m;
    client_body_timeout 120s;

    access_log /var/log/nginx/roamlog-media.access.log;
    error_log /var/log/nginx/roamlog-media.error.log;

    # Method allow-list. OPTIONS is intentionally allowed through to MinIO:
    # browsers preflight cross-origin PUT (and custom headers) and MinIO answers
    # from the bucket CORS policy configured by docker/minio-init. Rejecting
    # OPTIONS here would make uploads fail with a CORS error even though the
    # signature is valid.
    if ($request_method !~ ^(GET|HEAD|PUT|OPTIONS)$) {
        return 405;
    }

    location / {
        proxy_pass http://127.0.0.1:19000;
        proxy_http_version 1.1;

        # THE critical line: MinIO re-derives the SigV4 signature from the Host
        # header. Forwarding the public host is what makes presigned URLs work.
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        # Stream uploads/downloads instead of buffering them through Nginx.
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 60s;
        proxy_send_timeout 300s;
    }
}