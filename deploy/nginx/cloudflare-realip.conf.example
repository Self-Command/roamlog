# Install as /etc/nginx/snippets/cloudflare-realip.conf.
#
# Add only the current Cloudflare IPv4/IPv6 ranges published at:
# https://www.cloudflare.com/ips/
#
# Example shape (replace every range; never use 0.0.0.0/0 or ::/0):
#   set_real_ip_from 203.0.113.0/24;
#   set_real_ip_from 2001:db8::/32;
#
# Keep this header even when Cloudflare is disabled; without any
# set_real_ip_from directive it has no effect and keeps nginx -t valid.
real_ip_header CF-Connecting-IP;
