# Production same-origin ingress for https://we.spacedo.org.
#
# Keep only this Nginx instance in front of the app ports. If Cloudflare
# proxies the hostname, install its published ranges in
# /etc/nginx/snippets/cloudflare-realip.conf, use CF-Connecting-IP as the real
# IP header, and restrict origin TCP 80/443 to Cloudflare. Never add a second
# trusted proxy between Nginx and the API.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

upstream roamlog_web_upstream {
    server 127.0.0.1:13000;
    keepalive 16;
}

upstream roamlog_admin_upstream {
    server 127.0.0.1:13001;
    keepalive 16;
}

upstream roamlog_api_upstream {
    server 127.0.0.1:14000;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name we.spacedo.org;

    include /etc/nginx/snippets/cloudflare-realip.conf;
    access_log /var/log/nginx/roamlog-http.access.log;
    error_log /var/log/nginx/roamlog-http.error.log;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name we.spacedo.org;
    server_tokens off;

    include /etc/nginx/snippets/cloudflare-realip.conf;
    include /etc/letsencrypt/options-ssl-nginx.conf;

    ssl_certificate /etc/letsencrypt/live/we.spacedo.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/we.spacedo.org/privkey.pem;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=(), usb=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Resource-Policy "same-site" always;
    # Media host note: `img-src ... https:` already permits the media origin
    # (https://media.spacedo.org) without naming it, and `connect-src ... https:`
    # permits the presigned PUT/XHR used by uploads. That is sufficient today.
    # If this CSP is ever tightened to an explicit host allow-list, add the media
    # origin to `img-src`, `media-src` and `connect-src` together.
    # See deploy/nginx/media.conf.example.
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: wss:; worker-src 'self' blob:; media-src 'self' blob: https:" always;

    client_max_body_size 30m;
    client_body_timeout 60s;
    keepalive_timeout 65s;
    keepalive_requests 1000;

    access_log /var/log/nginx/roamlog.access.log;
    error_log /var/log/nginx/roamlog.error.log;

    location = /v1/metrics {
        return 404;
    }

    location ^~ /v1/ws {
        proxy_pass http://roamlog_api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location ^~ /v1/ {
        proxy_pass http://roamlog_api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    location = /admin {
        proxy_pass http://roamlog_admin_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    location ^~ /admin-assets/ {
        rewrite ^/admin-assets/(.*)$ /$1 break;
        proxy_pass http://roamlog_admin_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    location ^~ /admin/ {
        proxy_pass http://roamlog_admin_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    location / {
        proxy_pass http://roamlog_web_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}
